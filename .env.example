# =============================================================================
# Personal COO - environment configuration reference
#
# Copy to .env for local overrides. .env is gitignored; THIS file is committed
# and must never contain a real value for anything sensitive.
#
# Every variable the application reads is listed here. Each one is optional -
# the app runs with none of them set, and configuration parsing is total: a bad
# value degrades to the default below and logs a warning rather than crashing
# at startup. See AppOptionsParser and its tests.
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND (ASP.NET Core API)
# -----------------------------------------------------------------------------

# Serve generated demo data instead of a personal database.
# Accepts: true/false, 1/0, yes/no, on/off (case-insensitive).
# Anything else is ignored with a warning and treated as false, so a typo can
# never turn demo mode on for a personal instance.
# Default: false
DEMO_MODE=false

# SQLite file path.
# IGNORED ENTIRELY when DEMO_MODE=true - demo mode always uses demo.db, so no
# configuration mistake can point demo seeding at a real database. Honoured only
# when DEMO_MODE=false.
# Default: projectmanager.db (personal) / demo.db (demo, not overridable)
# DATABASE_PATH=projectmanager.db

# Comma-separated list of browser origins allowed to call the API.
# Origins only: scheme + host + port. No path, no trailing slash - a path is
# stripped with a warning, and a literal "*" is DROPPED, because this API has no
# authentication and a wildcard should not be reachable through configuration.
# Default: http://localhost:5174, http://127.0.0.1:5174
# CORS_ALLOWED_ORIGINS=https://andreibautin.github.io

# Expose Swagger UI. Off by default and deliberately off in the deployment:
# Swagger is a live writable interface onto a public unauthenticated API.
# Default: false
ENABLE_SWAGGER=false

# Minimum log level: Trace, Debug, Information, Warning, Error, Critical, None.
# An unrecognised value falls back to Information with a warning.
# Default: Information
LOG_LEVEL=Information

# Build identification, surfaced on /api/health so a running service can be tied
# back to the commit it was built from. Injected by CI; not set by hand.
# Defaults: "unknown" / "dev"
# BUILD_COMMIT=
# BUILD_VERSION=

# Port to listen on. Set automatically by container hosts such as Render; the
# Dockerfile reads it at runtime and falls back to 8080.
# PORT=8080


# -----------------------------------------------------------------------------
# FRONTEND (Vite + React)
#
# !! READ THIS BEFORE ADDING A VARIABLE !!
#
# Vite exposes ONLY variables prefixed with VITE_ to client code - and every one
# it exposes is compiled into the JavaScript bundle that any visitor can read.
# A VITE_-prefixed variable is PUBLIC BY DEFINITION. Never put an API key, a
# token, a password or any other credential behind that prefix. This app has no
# client-side secrets and should stay that way.
#
# These are build-time values: changing one means rebuilding, not restarting.
# -----------------------------------------------------------------------------

# Absolute base URL of the API.
# Unset (local development): defaults to the relative path /api, which the Vite
# dev server proxies to localhost:5071.
# Set (deployed): the Render service origin, including the /api suffix.
# VITE_API_BASE_URL=https://personal-coo-api.onrender.com/api

# Public path the SPA is served from.
# A GitHub Pages project site lives at /<repo>/, not at /. This single value
# feeds both Vite's asset base and the React Router basename - see src/config.ts.
# Must have a leading AND trailing slash.
# Default: /
# VITE_BASE_PATH=/ProjectManager/

# Shows the "this is generated demo data" banner. Cosmetic only - the backend's
# DEMO_MODE is what actually determines which data is served.
# Default: false
# VITE_DEMO_MODE=true

# Short commit SHA, shown in the footer so a deployed page identifies its build.
# Injected by CI.
# Default: dev
# VITE_BUILD_COMMIT=

# Override the dev-server proxy target if the backend runs somewhere other than
# localhost:5071.
# Default: http://localhost:5071
# VITE_DEV_API_TARGET=http://localhost:5071
