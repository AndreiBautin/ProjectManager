<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- This machine only has the .NET 9 runtime installed, not .NET 8.
         Roll forward to whatever major runtime is present rather than
         requiring an exact .NET 8 runtime install. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!--
    Versions are floated to "latest 8.0.x" rather than pinned to an exact patch,
    since this project was scaffolded without NuGet access to confirm exact
    current patch numbers. `dotnet restore` will pick up the newest compatible
    release. Swashbuckle isn't tied to the runtime's versioning at all, so it
    floats on its major version instead.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
